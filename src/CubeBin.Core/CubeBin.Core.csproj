<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Toda a lógica do CubeBin, sem nada de tela, para Windows e Linux (net8.0 puro):
    - Plataforma: pastas do sistema (Known Folders / XDG), ausência do usuário, notificações do
      Linux, abrir junto com o sistema, Lixeira.
    - Configuracao: o arquivo JSON legível e editável à mão.
    - Organizar: regras por tipo, proteções, prévia, mover direto e Desfazer.
    - Registros e Relatorios: o registro JSON gravado arquivo por arquivo e o relatório HTML.
    - LiberarEspaco, Cubos, Nuvem (Google Drive) e Agente (sugestões de limpeza).
    O que é só do Windows fica atrás de OperatingSystem.IsWindows().
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>CubeBin.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Google Drive (envio dos Cubos e login OAuth com o escopo restrito drive.file). -->
    <PackageReference Include="Google.Apis.Auth" Version="1.68.0" />
    <PackageReference Include="Google.Apis.Drive.v3" Version="1.68.0.3466" />
    <!-- DPAPI: guarda o token do Google criptografado pela conta do Windows. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- O modelo do relatório vai dentro da DLL: funciona offline e não some do disco. -->
    <EmbeddedResource Include="Relatorios\ModeloRelatorio.html" LogicalName="CubeBin.ModeloRelatorio.html" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CubeBin.Tests" />
  </ItemGroup>

</Project>
