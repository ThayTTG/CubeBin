<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A lógica do CubeBin a partir da versão 3, sem nada de tela: o agente de sugestões (duplicados,
    temporários antigos, arquivos grandes parados), o apagar com registro, e o backup no Google
    Drive (os Cubos). A organização de arquivos virou um app à parte (src/Organizador.*).
  -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>CubeBin.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Integração com Google Drive (upload/download de arquivos, autenticação OAuth). -->
    <PackageReference Include="Google.Apis.Auth" Version="1.68.0" />
    <PackageReference Include="Google.Apis.Drive.v3" Version="1.68.0.3466" />
    <!-- DPAPI: criptografa o token OAuth em disco, ligado à conta do Windows do usuário —
         "sem token bruto" (Camada 3). Sabidamente não incluído por padrão mesmo em TFMs -windows. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Comum" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Comum\Comum.csproj" />
  </ItemGroup>

</Project>
