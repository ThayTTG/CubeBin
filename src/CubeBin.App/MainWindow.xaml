<Window x:Class="CubeBin.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CubeBin" Height="640" Width="900"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" x:Name="PainelStatus" Visibility="Collapsed"
                Background="{StaticResource WarningBackgroundBrush}" BorderBrush="{StaticResource WarningBorderBrush}" BorderThickness="0,1,0,0" Padding="12,8">
            <StackPanel Orientation="Horizontal">
                <ProgressBar IsIndeterminate="True" Width="140" Height="14" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}" />
                <TextBlock x:Name="TxtStatusOrganizando" Text="Organizando arquivos..." VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource WarningTextBrush}" />
            </StackPanel>
        </Border>

        <!-- Estrutura em 3 módulos (Organizar/Limpar/Deletar) + Sugestões/Cubos/Histórico/Configurações/Login
             como itens próprios da sidebar. Cada item tem um ícone (item 3 do refinamento visual). -->
        <TabControl x:Name="AbaPrincipal" Margin="8" SelectionChanged="AbaPrincipal_SelectionChanged">

        <!-- ===================== ORGANIZAR ===================== -->
        <TabItem x:Name="TabOrganizar" ToolTip="Organizar">
            <TabItem.Header>
                <StackPanel Orientation="Horizontal">
                    <Canvas Width="18" Height="16" Margin="0,0,10,0">
                        <Path Data="M0,3 L6,3 L8,5 L18,5 L18,15 L0,15 Z" Fill="{StaticResource TextPrimaryBrush}" />
                    </Canvas>
                    <TextBlock x:Name="TxtLabelOrganizar" Text="Organizar" VerticalAlignment="Center" />
                </StackPanel>
            </TabItem.Header>
            <TabControl x:Name="AbaOrganizarInterna" Style="{StaticResource SubTabControlStyle}">

                <!-- Regras de extensão -->
                <TabItem Header="Regras de extensão" Style="{StaticResource SubTabItemStyle}">
                    <DockPanel Margin="16">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="Editando regras de:" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ComboBox x:Name="ComboContextoRegras" Width="180" Margin="0,0,16,0" SelectionChanged="ComboContextoRegras_SelectionChanged" />
                            <Button x:Name="BtnAdicionarRegra" Content="Nova regra" Style="{StaticResource PrimaryButtonStyle}" Padding="8,4" Margin="0,0,8,0" Click="BtnAdicionarRegra_Click" />
                            <Button x:Name="BtnRemoverRegra" Content="Remover regra selecionada" Padding="8,4" Margin="0,0,8,0" Click="BtnRemoverRegra_Click" />
                            <Button x:Name="BtnUsarPadrao" Content="Usar regras padrão nesta pasta" Padding="8,4" Click="BtnUsarPadrao_Click" />
                        </StackPanel>
                        <Button DockPanel.Dock="Bottom" x:Name="BtnSalvarRegras" Content="Salvar alterações" Style="{StaticResource PrimaryButtonStyle}" Padding="8,4" HorizontalAlignment="Right" Margin="0,8,0,0" Click="BtnSalvarRegras_Click" />
                        <DataGrid x:Name="GridRegras" AutoGenerateColumns="False" IsReadOnly="False" CanUserAddRows="False"
                                  PreviewMouseRightButtonDown="GridRegras_PreviewMouseRightButtonDown"
                                  ToolTip="1 clique seleciona · 2 cliques edita o texto · botão direito mostra mais opções">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Chave" Binding="{Binding Chave}" Width="120" />
                                <DataGridTextColumn Header="Extensões (separadas por vírgula)" Binding="{Binding ExtensoesTexto}" Width="220" />
                                <DataGridComboBoxColumn x:Name="ColunaTipoDestino" Header="Tipo" SelectedItemBinding="{Binding TipoTexto}" Width="100" />
                                <DataGridTextColumn Header="Pasta de destino (Local)" Binding="{Binding Destino}" Width="140" />
                                <DataGridTextColumn Header="Caminho no Drive (Google Drive)" Binding="{Binding CaminhoDrive}" Width="200" />
                                <DataGridTextColumn Header="Subpastas configuradas" Binding="{Binding SubpastasResumo}" Width="160" IsReadOnly="True" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>

                <!-- Pendências -->
                <TabItem Header="Pendências" Style="{StaticResource SubTabItemStyle}">
                    <DockPanel Margin="16">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                            <Button x:Name="BtnRecarregarPendencias" Content="Recarregar" Padding="8,4" Margin="0,0,8,0" Click="BtnRecarregarPendencias_Click" />
                            <Button x:Name="BtnIgnorarPendencia" Content="Ignorar selecionada" Padding="8,4" Click="BtnIgnorarPendencia_Click" />
                        </StackPanel>
                        <DataGrid x:Name="GridPendencias" AutoGenerateColumns="False" IsReadOnly="True"
                                  MouseDoubleClick="GridPendencias_MouseDoubleClick"
                                  ToolTip="Duplo clique para escolher em qual pasta/regra existente organizar este arquivo">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Arquivo" Binding="{Binding NomeArquivo}" Width="200" />
                                <DataGridTextColumn Header="Extensão" Binding="{Binding Extensao}" Width="90" />
                                <DataGridTextColumn Header="Pasta de origem" Binding="{Binding PastaOrigemId}" Width="130" />
                                <DataGridTextColumn Header="Detectado em" Binding="{Binding DataDeteccao}" Width="150" />
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>

            </TabControl>
        </TabItem>

        <!-- ===================== LIMPAR ===================== -->
        <TabItem x:Name="TabLimpar" ToolTip="Limpar">
            <TabItem.Header>
                <StackPanel Orientation="Horizontal">
                    <Canvas Width="18" Height="18" Margin="0,0,10,0">
                        <Polygon Points="3,15 8,3 17,7 12,19" Fill="{StaticResource TextPrimaryBrush}" />
                    </Canvas>
                    <TextBlock x:Name="TxtLabelLimpar" Text="Limpar" VerticalAlignment="Center" />
                </StackPanel>
            </TabItem.Header>
            <DockPanel Margin="16">
                <TextBlock DockPanel.Dock="Top" Text="Pastas padrão do Windows podem ser limpas e restauradas, mas nunca deletadas. Pastas personalizadas podem ser criadas e excluídas livremente." TextWrapping="Wrap" Opacity="0.8" Margin="0,0,0,10" />
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                    <Button x:Name="BtnAdicionarPasta" Content="Adicionar pasta personalizada" Style="{StaticResource PrimaryButtonStyle}" Padding="8,4" Margin="0,0,8,0" Click="BtnAdicionarPasta_Click" />
                    <Button x:Name="BtnRemoverPasta" Content="Remover pasta selecionada" Padding="8,4" Margin="0,0,8,0" Click="BtnRemoverPasta_Click" />
                    <Button x:Name="BtnLimparPastaPadrao" Content="Limpar pasta padrão" Padding="8,4" Margin="0,0,8,0" Click="BtnLimparPastaPadrao_Click" />
                    <Button x:Name="BtnRestaurarPastaPadrao" Content="Restaurar pasta padrão" Padding="8,4" Click="BtnRestaurarPastaPadrao_Click" />
                </StackPanel>
                <Button DockPanel.Dock="Bottom" x:Name="BtnSalvarPastas" Content="Salvar alterações" Style="{StaticResource PrimaryButtonStyle}" Padding="8,4" HorizontalAlignment="Right" Margin="0,8,0,0" Click="BtnSalvarPastas_Click" />
                <DataGrid x:Name="GridPastas" AutoGenerateColumns="False" IsReadOnly="False" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nome" Binding="{Binding Nome}" Width="150" IsReadOnly="True" />
                        <DataGridTextColumn Header="Caminho" Binding="{Binding Caminho}" Width="300" IsReadOnly="True" />
                        <DataGridCheckBoxColumn Header="Organizar subpastas" Binding="{Binding OrganizarSubpastas}" Width="140" />
                        <DataGridTextColumn Header="Tipo" Binding="{Binding TipoExibicao}" Width="110" IsReadOnly="True" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </TabItem>

        <!-- ===================== DELETAR ===================== -->
        <TabItem x:Name="TabDeletar" ToolTip="Deletar">
            <TabItem.Header>
                <StackPanel Orientation="Horizontal">
                    <Canvas Width="16" Height="18" Margin="0,0,10,0">
                        <Rectangle Canvas.Left="2" Canvas.Top="1" Width="12" Height="2" Fill="{StaticResource TextPrimaryBrush}" />
                        <Path Data="M3,4 L13,4 L12,17 L4,17 Z" Fill="{StaticResource TextPrimaryBrush}" />
                    </Canvas>
                    <TextBlock x:Name="TxtLabelDeletar" Text="Deletar" VerticalAlignment="Center" />
                </StackPanel>
            </TabItem.Header>
            <DockPanel Margin="16">
                <TextBlock DockPanel.Dock="Top" Text="Selecione arquivos ou pastas de qualquer lugar do computador para excluir definitivamente. Um backup em CSV do que será apagado é gerado antes da exclusão — mas a exclusão em si não pode ser desfeita pelo app." TextWrapping="Wrap" Opacity="0.8" Margin="0,0,0,10" />
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                    <Button x:Name="BtnDeletarAdicionarArquivos" Content="Selecionar arquivos..." Style="{StaticResource PrimaryButtonStyle}" Padding="8,4" Margin="0,0,8,0" Click="BtnDeletarAdicionarArquivos_Click" />
                    <Button x:Name="BtnDeletarAdicionarPasta" Content="Selecionar pasta..." Padding="8,4" Margin="0,0,8,0" Click="BtnDeletarAdicionarPasta_Click" />
                    <Button x:Name="BtnDeletarRemoverDaLista" Content="Remover da lista" Padding="8,4" Click="BtnDeletarRemoverDaLista_Click" />
                </StackPanel>

                <Border DockPanel.Dock="Bottom" Background="{StaticResource WarningBackgroundBrush}" BorderBrush="{StaticResource WarningBorderBrush}" BorderThickness="1" Padding="10" Margin="0,8,0,0">
                    <StackPanel>
                        <TextBlock x:Name="TxtResumoDeletar" Text="Nenhum item selecionado." TextWrapping="Wrap" Foreground="{StaticResource WarningTextBrush}" Margin="0,0,0,8" />
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="BtnExcluirDefinitivamente" Content="Excluir definitivamente" Style="{StaticResource PrimaryButtonStyle}" Padding="8,4" IsEnabled="False" Margin="0,0,8,0" Click="BtnExcluirDefinitivamente_Click" />
                            <Button x:Name="BtnDeletarEnviarNuvem" Content="Enviar à nuvem e excluir" Padding="8,4" IsEnabled="False" Click="BtnDeletarEnviarNuvem_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Grid>
                    <DataGrid x:Name="GridDeletar" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nome" Binding="{Binding Nome}" Width="220" />
                            <DataGridTextColumn Header="Caminho" Binding="{Binding Caminho}" Width="360" />
                            <DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" Width="90" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Estado vazio: zona de arraste real (AllowDrop) com borda tracejada -->
                    <Grid x:Name="PainelVazioDeletar" Visibility="Collapsed" Margin="24"
                          AllowDrop="True" Drop="PainelVazioDeletar_Drop"
                          DragEnter="PainelVazioDeletar_DragEnter" DragLeave="PainelVazioDeletar_DragLeave">
                        <Rectangle x:Name="RetanguloTracejadoDeletar" Stroke="{StaticResource BorderStrongBrush}" StrokeThickness="2"
                                   StrokeDashArray="6,4" RadiusX="8" RadiusY="8" Fill="Transparent" />
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                            <Canvas Width="64" Height="56" HorizontalAlignment="Center">
                                <Rectangle Canvas.Left="8" Canvas.Top="18" Width="16" Height="8" Fill="#5f6269" />
                                <Rectangle Canvas.Left="8" Canvas.Top="26" Width="48" Height="22" Fill="#45474d" />
                                <Rectangle Canvas.Left="29" Canvas.Top="2" Width="6" Height="20" Fill="#9a9da3" />
                                <Polygon Points="20,20 44,20 32,34" Fill="#9a9da3" />
                            </Canvas>
                            <TextBlock Text="Arraste arquivos aqui" FontWeight="Bold" FontSize="14"
                                       HorizontalAlignment="Center" TextAlignment="Center" Margin="0,14,0,4" />
                            <TextBlock Text="Ou use os botões acima para selecionar arquivos e pastas."
                                       Opacity="0.7" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Width="260" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </DockPanel>
        </TabItem>

        <!-- Sugestões (Camada 2): agente opcional de heurísticas locais, desativado por padrão -->
        <TabItem x:Name="TabSugestoes" ToolTip="Sugestões">
            <TabItem.Header>
                <StackPanel Orientation="Horizontal">
                    <Canvas Width="16" Height="20" Margin="0,0,10,0">
                        <Ellipse Canvas.Left="2" Canvas.Top="1" Width="12" Height="12" Fill="{StaticResource TextPrimaryBrush}" />
                        <Rectangle Canvas.Left="5" Canvas.Top="12" Width="6" Height="5" Fill="{StaticResource TextPrimaryBrush}" />
                        <Rectangle Canvas.Left="5" Canvas.Top="18" Width="6" Height="2" RadiusX="1" RadiusY="1" Fill="{StaticResource TextPrimaryBrush}" />
                    </Canvas>
                    <TextBlock x:Name="TxtLabelSugestoes" Text="Sugestões" VerticalAlignment="Center" />
                </StackPanel>
            </TabItem.Header>
            <DockPanel Margin="16">
                <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Opacity="0.8" Margin="0,0,0,10"
                           Text="Agente opcional que sugere arquivos que podem ser limpos (duplicados, temporários antigos, arquivos grandes parados) usando só heurísticas locais — sem IA externa, sem depender de internet. Nada é apagado sem sua aprovação explícita, e o agente vem desativado por padrão." />

                <Border DockPanel.Dock="Top" BorderBrush="{StaticResource BorderLineBrush}" BorderThickness="1" Padding="12" Margin="0,0,0,10">
                    <StackPanel>
                        <CheckBox x:Name="ChkAgenteAtivo" Content="Agente ativo" Margin="0,0,0,12" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Dias sem uso p/ temporários" Margin="0,0,0,2" />
                                <TextBox x:Name="TxtAgenteDiasTemporario" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Dias parado p/ arquivo grande" Margin="0,0,0,2" />
                                <TextBox x:Name="TxtAgenteDiasGrande" />
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Tamanho mínimo &quot;grande&quot; (MB)" Margin="0,0,0,2" />
                                <TextBox x:Name="TxtAgenteTamanhoMinimoMb" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Vezes por dia que o agente analisa (só quando você estiver ausente)" Margin="0,12,0,2" />
                        <TextBox x:Name="TxtAgenteExecucoesPorDia" Width="80" HorizontalAlignment="Left" />
                        <Button x:Name="BtnSalvarConfigAgente" Content="Salvar configurações do agente" Style="{StaticResource PrimaryButtonStyle}" Padding="8,4" Margin="0,12,0,0" HorizontalAlignment="Left" Click="BtnSalvarConfigAgente_Click" />
                    </StackPanel>
                </Border>

                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                    <Button x:Name="BtnAnalisarAgora" Content="Analisar agora" Style="{StaticResource PrimaryButtonStyle}" Padding="8,4" Margin="0,0,8,0" Click="BtnAnalisarAgora_Click" />
                    <Button x:Name="BtnRecarregarSugestoes" Content="Recarregar" Padding="8,4" Margin="0,0,8,0" Click="BtnRecarregarSugestoes_Click" />
                    <TextBlock x:Name="TxtResumoSugestoes" VerticalAlignment="Center" Text="Nenhuma sugestão pendente." Margin="8,0,0,0" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                    <Button x:Name="BtnIgnorarSugestoes" Content="Ignorar selecionadas" Padding="8,4" Margin="0,0,8,0" Click="BtnIgnorarSugestoes_Click" />
                    <Button x:Name="BtnAprovarSugestoes" Content="Aprovar selecionadas" Padding="8,4" Margin="0,0,8,0" Click="BtnAprovarSugestoes_Click" />
                    <Button x:Name="BtnExcluirAprovadas" Content="Excluir aprovadas" Style="{StaticResource PrimaryButtonStyle}" Padding="8,4" Margin="0,0,8,0" IsEnabled="False" Click="BtnExcluirAprovadas_Click" />
                    <Button x:Name="BtnSugestoesEnviarNuvem" Content="Enviar aprovadas à nuvem" Padding="8,4" IsEnabled="False" Click="BtnSugestoesEnviarNuvem_Click" />
                </StackPanel>

                <Grid>
                    <DataGrid x:Name="GridSugestoes" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" SelectionUnit="FullRow">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Arquivo" Binding="{Binding Nome}" Width="200" />
                            <DataGridTextColumn Header="Tipo" Binding="{Binding TipoTexto}" Width="140" />
                            <DataGridTextColumn Header="Motivo" Binding="{Binding Motivo}" Width="300" />
                            <DataGridTextColumn Header="Tamanho" Binding="{Binding TamanhoTexto}" Width="90" />
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Estado vazio: pilha de 3 cubos cinza (ilustração de sistema, não um Cubo de verdade) -->
                    <StackPanel x:Name="PainelVazioSugestoes" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Canvas Width="90" Height="80" HorizontalAlignment="Center">
                            <Polygon Points="45,8 65,20 45,32 25,20" Fill="#8a8d94" />
                            <Polygon Points="25,20 45,32 45,42 25,30" Fill="#5f6269" />
                            <Polygon Points="65,20 45,32 45,42 65,30" Fill="#45474d" />
                            <Polygon Points="28,38 48,50 48,60 28,48" Fill="#6a6d74" />
                            <Polygon Points="48,50 68,38 68,48 48,60" Fill="#3f4147" />
                            <Polygon Points="28,38 48,26 68,38 48,50" Fill="#9a9da3" />
                        </Canvas>
                        <TextBlock Text="Tudo limpo por aqui" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" Margin="0,14,0,4" />
                        <TextBlock Text="Assim que o agente encontrar algo, as sugestões aparecem empilhadas bem aqui."
                                   Opacity="0.7" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Width="260" Margin="0,0,0,14" />
                        <Button x:Name="BtnAnalisarAgoraVazio" Content="Analisar agora" Style="{StaticResource PrimaryButtonStyle}"
                                Padding="8,4" HorizontalAlignment="Center" Click="BtnAnalisarAgora_Click" />
                    </StackPanel>
                </Grid>
            </DockPanel>
        </TabItem>

        <!-- Cubos (Camada 4): cada pacote de backup enviado à nuvem vira um cubo visual -->
        <TabItem x:Name="TabCubos" ToolTip="Cubos">
            <TabItem.Header>
                <StackPanel Orientation="Horizontal">
                    <Canvas Width="18" Height="18" Margin="0,0,10,0">
                        <Polygon Points="9,2 16,6 9,10 2,6" Fill="{StaticResource AccentBrush}" />
                        <Polygon Points="2,6 9,10 9,17 2,13" Fill="{StaticResource AccentHoverBrush}" />
                        <Polygon Points="16,6 9,10 9,17 16,13" Fill="{StaticResource AccentPressedBrush}" />
                    </Canvas>
                    <TextBlock x:Name="TxtLabelCubos" Text="Cubos" VerticalAlignment="Center" />
                </StackPanel>
            </TabItem.Header>
            <DockPanel Margin="16">
                <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Opacity="0.8" Margin="0,0,0,10"
                           Text="Cada cubo representa um pacote de backup enviado à nuvem. Passe o mouse para ver o que tem dentro; clique para ver os detalhes, abrir no Drive ou restaurar." />
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                    <Button x:Name="BtnRecarregarCubos" Content="Recarregar" Padding="8,4" Click="BtnRecarregarCubos_Click" />
                </StackPanel>

                <Grid>
                    <ScrollViewer x:Name="ScrollCubos" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="ListaCubos">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="14" Width="120" Cursor="Hand" MouseLeftButtonUp="Cubo_MouseLeftButtonUp" ToolTip="{Binding ResumoCategorias}">
                                        <StackPanel HorizontalAlignment="Center">
                                            <Canvas Width="76" Height="76" Opacity="{Binding OpacidadeCubo}">
                                                <Polygon Points="12,24 38,10 64,24 38,38" Fill="{StaticResource AccentBrush}" />
                                                <Polygon Points="12,24 38,38 38,68 12,54" Fill="{StaticResource AccentHoverBrush}" />
                                                <Polygon Points="64,24 38,38 38,68 64,54" Fill="{StaticResource AccentPressedBrush}" />
                                            </Canvas>
                                            <TextBlock Text="{Binding NomeArquivoZip}" HorizontalAlignment="Center" FontSize="10"
                                                       TextTrimming="CharacterEllipsis" Width="110" Margin="0,6,0,0" />
                                            <TextBlock Text="{Binding TamanhoTexto}" HorizontalAlignment="Center" FontSize="10" Opacity="0.7" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Estado vazio: um único cubo cinza "flutuando" semi-transparente -->
                    <StackPanel x:Name="PainelVazioCubos" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Canvas Width="76" Height="76" HorizontalAlignment="Center" Opacity="0.4">
                            <Polygon Points="12,24 38,10 64,24 38,38" Fill="#9a9da3" />
                            <Polygon Points="12,24 38,38 38,68 12,54" Fill="#6a6d74" />
                            <Polygon Points="64,24 38,38 38,68 64,54" Fill="#3f4147" />
                        </Canvas>
                        <TextBlock Text="Nenhum cubo ainda" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" Margin="0,14,0,4" />
                        <TextBlock Text="Seu primeiro backup enviado aparece flutuando bem aqui."
                                   Opacity="0.7" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Width="260" />
                    </StackPanel>
                </Grid>
            </DockPanel>
        </TabItem>

        <!-- ===================== HISTÓRICO (absorve o Recall) ===================== -->
        <TabItem x:Name="TabHistorico" ToolTip="Histórico">
            <TabItem.Header>
                <StackPanel Orientation="Horizontal">
                    <Canvas Width="18" Height="18" Margin="0,0,10,0">
                        <Ellipse Canvas.Left="1" Canvas.Top="1" Width="16" Height="16" Stroke="{StaticResource TextPrimaryBrush}" StrokeThickness="2" Fill="Transparent" />
                        <Line X1="9" Y1="9" X2="9" Y2="4" Stroke="{StaticResource TextPrimaryBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <Line X1="9" Y1="9" X2="13" Y2="11" Stroke="{StaticResource TextPrimaryBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Canvas>
                    <TextBlock x:Name="TxtLabelHistorico" Text="Histórico" VerticalAlignment="Center" />
                </StackPanel>
            </TabItem.Header>
            <DockPanel Margin="16">
                <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Opacity="0.8" Margin="0,0,0,10"
                           Text="Cada backup em CSV abaixo corresponde a uma execução. Selecione um e clique em 'Ver itens desta execução' para revisar (e, se precisar, devolver) os arquivos movidos nela." />

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="180" />
                        <RowDefinition Height="6" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Backups em CSV -->
                    <DockPanel Grid.Row="0">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                            <Button x:Name="BtnRecarregarHistorico" Content="Recarregar" Padding="8,4" Margin="0,0,8,0" Click="BtnRecarregarHistorico_Click" />
                            <Button x:Name="BtnVerItensExecucao" Content="Ver itens desta execução" Padding="8,4" Margin="0,0,8,0" Click="BtnVerItensExecucao_Click" />
                            <Button x:Name="BtnLimparFiltroRecall" Content="Mostrar tudo" Padding="8,4" Click="BtnLimparFiltroRecall_Click" />
                        </StackPanel>
                        <Grid>
                            <DataGrid x:Name="GridHistorico" AutoGenerateColumns="False" IsReadOnly="True"
                                      MouseDoubleClick="GridHistorico_MouseDoubleClick"
                                      ToolTip="Duplo clique para abrir o arquivo de backup">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Arquivo de backup" Binding="{Binding Nome}" Width="260" />
                                    <DataGridTextColumn Header="Criado em" Binding="{Binding CriadoEm}" Width="160" />
                                    <DataGridTextColumn Header="Tamanho (KB)" Binding="{Binding TamanhoKb}" Width="120" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- Estado vazio: gaveteiro simples, uma gaveta entreaberta (silhueta em cinza) -->
                            <StackPanel x:Name="PainelVazioHistorico" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Canvas Width="80" Height="80" HorizontalAlignment="Center">
                                    <Rectangle Canvas.Left="15" Canvas.Top="8" Width="50" Height="56" Fill="#45474d" />
                                    <Rectangle Canvas.Left="18" Canvas.Top="11" Width="44" Height="14" Fill="#5f6269" />
                                    <Rectangle Canvas.Left="36" Canvas.Top="17" Width="8" Height="2" Fill="#3f4147" />
                                    <Rectangle Canvas.Left="18" Canvas.Top="28" Width="44" Height="14" Fill="#5f6269" />
                                    <Rectangle Canvas.Left="36" Canvas.Top="34" Width="8" Height="2" Fill="#3f4147" />
                                    <Rectangle Canvas.Left="15" Canvas.Top="46" Width="50" Height="20" Fill="#8a8d94" />
                                    <Rectangle Canvas.Left="34" Canvas.Top="58" Width="12" Height="3" RadiusX="1.5" RadiusY="1.5" Fill="#3f4147" />
                                </Canvas>
                                <TextBlock Text="Nada guardado ainda" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" Margin="0,14,0,4" />
                                <TextBlock Text="Cada backup em CSV que o app gerar fica registrado aqui."
                                           Opacity="0.7" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Width="260" />
                            </StackPanel>
                        </Grid>
                    </DockPanel>

                    <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" />

                    <!-- Recall absorvido: mesmos controles/lógica de antes, agora dentro de Histórico -->
                    <DockPanel Grid.Row="2" Margin="0,8,0,0">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                            <Button x:Name="BtnRecarregarRecall" Content="Recarregar" Padding="8,4" Margin="0,0,16,0" Click="BtnRecarregarRecall_Click" />

                            <Border Background="{StaticResource RecallAtivoBrush}" Width="14" Height="14" Margin="0,0,4,0" />
                            <TextBlock Text="Organizado" VerticalAlignment="Center" Margin="0,0,16,0" />
                            <Border Background="{StaticResource RecallPendenteBrush}" Width="14" Height="14" Margin="0,0,4,0" />
                            <TextBlock Text="Será devolvido ao salvar" VerticalAlignment="Center" Margin="0,0,16,0" />
                            <Border Background="{StaticResource RecallRestauradoBrush}" Width="14" Height="14" Margin="0,0,4,0" />
                            <TextBlock Text="Devolvido ao local de origem" VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                            <Button x:Name="BtnCancelarRecall" Content="Cancelar" Padding="8,4" Margin="0,0,8,0" IsEnabled="False" Click="BtnCancelarRecall_Click" />
                            <Button x:Name="BtnDesfazerRecall" Content="Desfazer" Padding="8,4" Margin="0,0,8,0" IsEnabled="False" Click="BtnDesfazerRecall_Click" />
                            <Button x:Name="BtnSalvarRecall" Content="Salvar" Style="{StaticResource PrimaryButtonStyle}" Padding="8,4" IsEnabled="False" Click="BtnSalvarRecall_Click" />
                        </StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TreeView x:Name="TreeRecall" Grid.Column="0" SelectedItemChanged="TreeRecall_SelectedItemChanged" />

                            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" />

                            <DataGrid x:Name="GridRecall" Grid.Column="2" AutoGenerateColumns="False" IsReadOnly="True"
                                      SelectionMode="Extended" SelectionUnit="FullRow"
                                      PreviewMouseRightButtonDown="GridRecall_PreviewMouseRightButtonDown"
                                      ToolTip="Ctrl/Shift + clique para selecionar vários — botão direito marca ou desmarca a devolução">
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CorLinha}" Value="Azul">
                                                <Setter Property="Background" Value="{StaticResource RecallAtivoBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding CorLinha}" Value="Amarelo">
                                                <Setter Property="Background" Value="{StaticResource RecallPendenteBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding CorLinha}" Value="Verde">
                                                <Setter Property="Background" Value="{StaticResource RecallRestauradoBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Arquivo" Binding="{Binding NomeArquivo}" Width="180" />
                                    <DataGridTextColumn Header="Local original" Binding="{Binding CaminhoOrigem}" Width="220" />
                                    <DataGridTextColumn Header="Local atual" Binding="{Binding CaminhoAtual}" Width="220" />
                                    <DataGridTextColumn Header="Movido em" Binding="{Binding MovidoEm}" Width="140" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </DockPanel>
                </Grid>
            </DockPanel>
        </TabItem>

        <!-- ===================== CONFIGURAÇÕES (fora dos módulos) ===================== -->
        <TabItem x:Name="TabConfiguracoes" ToolTip="Configurações">
            <TabItem.Header>
                <StackPanel Orientation="Horizontal">
                    <Canvas Width="18" Height="18" Margin="0,0,10,0">
                        <Ellipse Canvas.Left="4" Canvas.Top="4" Width="10" Height="10" Stroke="{StaticResource TextPrimaryBrush}" StrokeThickness="2" Fill="Transparent" />
                        <Rectangle Canvas.Left="7.5" Canvas.Top="0" Width="3" Height="4" Fill="{StaticResource TextPrimaryBrush}" />
                        <Rectangle Canvas.Left="7.5" Canvas.Top="14" Width="3" Height="4" Fill="{StaticResource TextPrimaryBrush}" />
                        <Rectangle Canvas.Left="0" Canvas.Top="7.5" Width="4" Height="3" Fill="{StaticResource TextPrimaryBrush}" />
                        <Rectangle Canvas.Left="14" Canvas.Top="7.5" Width="4" Height="3" Fill="{StaticResource TextPrimaryBrush}" />
                    </Canvas>
                    <TextBlock x:Name="TxtLabelConfiguracoes" Text="Configurações" VerticalAlignment="Center" />
                </StackPanel>
            </TabItem.Header>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Agendamento" FontWeight="Bold" Margin="0,0,0,8" />

                            <TextBlock Text="Quantas vezes por dia organizar" Margin="0,8,0,2" />
                            <TextBox x:Name="TxtExecucoesPorDia" />
                            <TextBlock Text="As execuções são espaçadas em 24h ÷ esse número, a partir do horário de início abaixo." FontStyle="Italic" Opacity="0.7" TextWrapping="Wrap" Margin="0,2,0,0" />

                            <TextBlock Text="Horário de início (HH:mm)" Margin="0,12,0,2" />
                            <TextBox x:Name="TxtHorarioInicio" />

                            <TextBlock Text="Tempo de ausência para iniciar (minutos)" Margin="0,12,0,2" />
                            <TextBox x:Name="TxtTempoAusencia" />

                            <TextBlock Text="Janela de cancelamento / comportamento de notificação (segundos)" Margin="0,12,0,2" />
                            <TextBox x:Name="TxtJanelaCancelamento" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Diretórios e inicialização" FontWeight="Bold" Margin="0,0,0,8" />

                            <TextBlock Text="Diretório temporário" Margin="0,8,0,2" />
                            <TextBox x:Name="TxtDiretorioTemporario" />

                            <TextBlock Text="Diretório de backups (CSV)" Margin="0,12,0,2" />
                            <TextBox x:Name="TxtDiretorioBackup" />

                            <TextBlock Text="Quantidade de backups a manter" Margin="0,12,0,2" />
                            <TextBox x:Name="TxtManterUltimosN" />

                            <CheckBox x:Name="ChkIniciarComWindows" Content="Iniciar automaticamente com o Windows" Margin="0,16,0,0" />
                        </StackPanel>
                    </Grid>

                    <Button x:Name="BtnSalvarConfigGerais" Content="Salvar configurações" Style="{StaticResource PrimaryButtonStyle}" Padding="8,4" Margin="0,24,0,0" HorizontalAlignment="Left" Click="BtnSalvarConfigGerais_Click" />

                    <Separator Margin="0,20,0,12" />
                    <TextBlock Text="Executar a organização agora, sem esperar o próximo horário agendado:" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <Button x:Name="BtnExecutarAgora" Content="Executar organização agora" Style="{StaticResource PrimaryButtonStyle}" Padding="8,4" HorizontalAlignment="Left" Click="BtnExecutarAgora_Click" />
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- ===================== LOGIN / CONTA ===================== -->
        <TabItem x:Name="TabLogin" ToolTip="Login">
            <TabItem.Header>
                <StackPanel Orientation="Horizontal">
                    <Canvas Width="20" Height="14" Margin="0,0,10,0">
                        <Ellipse Canvas.Left="1" Canvas.Top="4" Width="9" Height="9" Fill="{StaticResource TextPrimaryBrush}" />
                        <Ellipse Canvas.Left="7" Canvas.Top="0" Width="11" Height="11" Fill="{StaticResource TextPrimaryBrush}" />
                        <Ellipse Canvas.Left="13" Canvas.Top="4" Width="8" Height="8" Fill="{StaticResource TextPrimaryBrush}" />
                        <Rectangle Canvas.Left="4" Canvas.Top="7" Width="14" Height="6" Fill="{StaticResource TextPrimaryBrush}" />
                    </Canvas>
                    <TextBlock x:Name="TxtLabelLogin" Text="Login" VerticalAlignment="Center" />
                </StackPanel>
            </TabItem.Header>
            <StackPanel Margin="16">
                <TextBlock Text="Google Drive" FontWeight="Bold" FontSize="14" Margin="0,0,0,12" />

                <!-- Ícone de nuvem (item 2 do refinamento visual) — mesma paleta cinza das outras ilustrações -->
                <Canvas Width="70" Height="46" HorizontalAlignment="Left" Margin="0,0,0,14">
                    <Ellipse Canvas.Left="6" Canvas.Top="14" Width="28" Height="28" Fill="#6a6d74" />
                    <Ellipse Canvas.Left="24" Canvas.Top="4" Width="34" Height="34" Fill="#6a6d74" />
                    <Ellipse Canvas.Left="42" Canvas.Top="16" Width="24" Height="24" Fill="#6a6d74" />
                    <Rectangle Canvas.Left="14" Canvas.Top="26" Width="44" Height="16" Fill="#6a6d74" />
                </Canvas>

                <TextBlock x:Name="TxtLoginStatus" Text="Não conectado" Margin="0,0,0,8" />

                <!-- Chip de conta conectada, substitui o texto simples quando há sucesso -->
                <Border x:Name="ChipContaConectada" Visibility="Collapsed" Background="{StaticResource SidebarActiveBrush}"
                        BorderBrush="{StaticResource BorderLineBrush}" BorderThickness="1" Padding="10,6" HorizontalAlignment="Left" Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="#5BC98A" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock x:Name="TxtChipEmail" Text="" VerticalAlignment="Center" FontSize="12" />
                    </StackPanel>
                </Border>

                <TextBlock x:Name="TxtLoginArmazenamento" Text="" Margin="0,0,0,16" Opacity="0.85" />
                <Button x:Name="BtnLoginConectar" Content="Conectar ao Google Drive" Style="{StaticResource PrimaryButtonStyle}" Padding="8,4" HorizontalAlignment="Left" Click="BtnConectarGoogleDrive_Click" />
            </StackPanel>
        </TabItem>

    </TabControl>
    </DockPanel>
</Window>
