<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Estilos do CubeBin no padrão visual da NokyLabs (docs/guia-visual-nokylabs.md).
        Cores em Theme/Colors.xaml, ícones em Theme/Icons.xaml; aqui ficam formas, medidas,
        tipografia e o comportamento visual (hover, foco, ativo, desabilitado) de cada controle.

        Medidas do guia: cards canto 16 e padding 20; botões e campos canto 10; avisos canto 12;
        item do menu canto 10; pílulas 999. Espaçamentos em múltiplos de 4.
    -->

    <!-- ===================== MEDIDAS E FONTE ===================== -->
    <!-- O guia pede Segoe UI Variable com Segoe UI de reserva. O WPF não lê os eixos de peso de
         fontes variáveis (SemiBold e Bold viram o peso normal nela), então o app usa a Segoe UI
         estática, que tem os pesos de verdade e o mesmo desenho de letra. -->
    <FontFamily x:Key="FonteApp">Segoe UI</FontFamily>
    <CornerRadius x:Key="RaioCard">16</CornerRadius>
    <CornerRadius x:Key="RaioControle">10</CornerRadius>
    <CornerRadius x:Key="RaioAviso">12</CornerRadius>
    <CornerRadius x:Key="RaioPilula">999</CornerRadius>
    <Thickness x:Key="PaddingCard">20</Thickness>
    <Thickness x:Key="PaddingBotao">16,9</Thickness>
    <Thickness x:Key="PaddingCampo">12,9</Thickness>
    <Thickness x:Key="PaddingAviso">14,10</Thickness>
    <Thickness x:Key="MargemPagina">32,28,32,24</Thickness>

    <!-- ===================== JANELAS ===================== -->
    <!-- Aplicado explicitamente em cada janela (Style="{StaticResource JanelaStyle}"): no WPF um
         estilo implícito de Window não alcança classes derivadas como a MainWindow. -->
    <Style x:Key="JanelaStyle" TargetType="Window">
        <Setter Property="Background" Value="{StaticResource FundoBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextoBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource FonteApp}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- Contorno de foco de teclado: anel arredondado na cor clara do app, em vez do pontilhado padrão. -->
    <Style x:Key="FocoStyle">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-3" CornerRadius="12" BorderThickness="2" BorderBrush="{StaticResource AccentLightBrush}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== TEXTOS ===================== -->
    <Style x:Key="TituloPaginaStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource TextoBrush}" />
    </Style>

    <Style x:Key="DescricaoPaginaStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource TextoSecundarioBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="MaxWidth" Value="760" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Margin" Value="0,6,0,0" />
    </Style>

    <Style x:Key="TituloSecaoStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextoBrush}" />
    </Style>

    <Style x:Key="TextoSecundarioStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource TextoSecundarioBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="TextoPequenoStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource TextoApagadoBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="RotuloCampoStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextoSecundarioBrush}" />
        <Setter Property="Margin" Value="0,14,0,6" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- ===================== ÍCONES E ILUSTRAÇÕES ===================== -->
    <!-- Ícone de traço numa grade 24x24 (envolver num Viewbox para o tamanho final). A cor segue
         o Foreground do controle mais próximo (botão, item do menu), então acompanha hover/ativo. -->
    <Style x:Key="IconeStyle" TargetType="Path">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}" />
        <Setter Property="StrokeThickness" Value="2" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="StrokeLineJoin" Value="Round" />
    </Style>

    <!-- Traço das ilustrações dos estados vazios (grade 64x64), sempre em tons neutros. -->
    <Style x:Key="IlustracaoStyle" TargetType="Path">
        <Setter Property="Stroke" Value="{StaticResource IlustracaoTracoBrush}" />
        <Setter Property="StrokeThickness" Value="2" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="StrokeLineJoin" Value="Round" />
    </Style>

    <!-- ===================== CARDS, AVISOS E PÍLULAS ===================== -->
    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SuperficieBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BordaBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RaioCard}" />
        <Setter Property="Padding" Value="{StaticResource PaddingCard}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- Card que envolve uma tabela: padding menor para a lista aproveitar o espaço. -->
    <Style x:Key="CardListaStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
        <Setter Property="Padding" Value="6" />
    </Style>

    <Style x:Key="CardInterativoStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
        <Setter Property="Cursor" Value="Hand" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource SuperficieHoverBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource AccentSoftHoverBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="AvisoAtencaoStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource AtencaoSuaveBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource AtencaoBordaBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RaioAviso}" />
        <Setter Property="Padding" Value="{StaticResource PaddingAviso}" />
    </Style>

    <Style x:Key="AvisoMarcaStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource AccentSoftHoverBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RaioAviso}" />
        <Setter Property="Padding" Value="{StaticResource PaddingAviso}" />
    </Style>

    <Style x:Key="PilulaStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="{StaticResource RaioPilula}" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <!-- ===================== BOTÕES ===================== -->
    <!--
        Quatro tipos, como no guia: Contorno (padrão, implícito), Principal (PrimaryButtonStyle),
        Suave (BotaoSuaveStyle) e Perigo (BotaoPerigoStyle, para ações destrutivas). Todos aceitam
        um ícone em Tag="{StaticResource Icone...}", desenhado antes do texto na cor do botão;
        assim o código pode trocar o texto (ex.: "Enviando...") sem perder o ícone.
    -->
    <ControlTemplate x:Key="BotaoTemplate" TargetType="Button">
        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource RaioControle}"
                SnapsToDevicePixels="True">
            <StackPanel Orientation="Horizontal" Margin="{TemplateBinding Padding}"
                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center">
                <Viewbox x:Name="CaixaIcone" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center">
                    <Path Width="24" Height="24" Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                          Stroke="{TemplateBinding Foreground}" StrokeThickness="2" StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                </Viewbox>
                <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" />
            </StackPanel>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="Tag" Value="{x:Null}">
                <Setter TargetName="CaixaIcone" Property="Visibility" Value="Collapsed" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Contorno (ghost): transparente, borda 1px, texto secundário. -->
    <Style TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource BordaBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource TextoSecundarioBrush}" />
        <Setter Property="Padding" Value="{StaticResource PaddingBotao}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocoStyle}" />
        <Setter Property="Template" Value="{StaticResource BotaoTemplate}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource SuperficieHoverBrush}" />
                <Setter Property="Foreground" Value="{StaticResource TextoBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource SuperficieElevadaBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Principal: fundo Accent, texto branco. Uma ação principal por tela. -->
    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource TextoSobreAccentBrush}" />
        <Setter Property="Padding" Value="{StaticResource PaddingBotao}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocoStyle}" />
        <Setter Property="Template" Value="{StaticResource BotaoTemplate}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource AccentHoverBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource AccentHoverBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource AccentPressedBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource AccentPressedBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Suave: fundo AccentSoft, texto AccentLight. Ações secundárias importantes. -->
    <Style x:Key="BotaoSuaveStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource AccentLightBrush}" />
        <Setter Property="Padding" Value="{StaticResource PaddingBotao}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocoStyle}" />
        <Setter Property="Template" Value="{StaticResource BotaoTemplate}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource AccentSoftHoverBrush}" />
                <Setter Property="Foreground" Value="{StaticResource TextoBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Perigo: para apagar de vez. Fundo Perigo 14% e texto Perigo; no hover, fundo sólido.
         Sempre com ícone de lixeira, verbo explícito e confirmação antes de executar. -->
    <Style x:Key="BotaoPerigoStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource PerigoSuaveBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource PerigoBrush}" />
        <Setter Property="Padding" Value="{StaticResource PaddingBotao}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocoStyle}" />
        <Setter Property="Template" Value="{StaticResource BotaoTemplate}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource PerigoBrush}" />
                <Setter Property="Foreground" Value="{StaticResource TextoSobreAccentBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Botão do menu lateral (Recolher menu): mesmo desenho dos itens do menu. O ícone fica
         sem margem e o texto leva a margem, para o ícone centralizar quando o menu recolhe. -->
    <Style x:Key="BotaoMenuStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextoSecundarioBrush}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocoStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="{StaticResource RaioControle}"
                            Padding="{TemplateBinding Padding}">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="20" Height="20" VerticalAlignment="Center">
                                <Path Width="24" Height="24" Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                      Stroke="{TemplateBinding Foreground}" StrokeThickness="2" StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                            </Viewbox>
                            <ContentPresenter VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource SuperficieHoverBrush}" />
                <Setter Property="Foreground" Value="{StaticResource TextoBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===================== CAMPOS DE TEXTO ===================== -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource SuperficieBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextoBrush}" />
        <Setter Property="CaretBrush" Value="{StaticResource TextoBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BordaBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="{StaticResource PaddingCampo}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}" />
        <Setter Property="SelectionOpacity" Value="0.5" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource RaioControle}"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center" Focusable="False" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SuperficieHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SuperficieElevadaBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== CHECKBOX ===================== -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource TextoBrush}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocoStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Caixa" Width="20" Height="20" CornerRadius="6" BorderThickness="1"
                                Background="{StaticResource SuperficieBrush}" BorderBrush="{StaticResource BordaForteBrush}"
                                VerticalAlignment="Center">
                            <Viewbox Width="14" Height="14">
                                <Path x:Name="Visto" Width="24" Height="24" Data="{StaticResource IconeVisto}"
                                      Stroke="{StaticResource TextoSobreAccentBrush}" StrokeThickness="3"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Visibility="Collapsed" />
                            </Viewbox>
                        </Border>
                        <ContentPresenter x:Name="Conteudo" Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Caixa" Property="BorderBrush" Value="{StaticResource AccentLightBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Caixa" Property="Background" Value="{StaticResource AccentBrush}" />
                            <Setter TargetName="Caixa" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            <Setter TargetName="Visto" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="HasContent" Value="False">
                            <Setter TargetName="Conteudo" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== COMBOBOX ===================== -->
    <Style TargetType="ComboBox">
        <Setter Property="Background" Value="{StaticResource SuperficieBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextoBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BordaBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocoStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="Alternador" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Bd" Background="{StaticResource SuperficieBrush}" BorderBrush="{StaticResource BordaBrush}"
                                            BorderThickness="1" CornerRadius="{StaticResource RaioControle}">
                                        <Viewbox Width="16" Height="16" HorizontalAlignment="Right" Margin="0,0,12,0">
                                            <Path Width="24" Height="24" Data="{StaticResource IconeChevronBaixo}"
                                                  Stroke="{StaticResource TextoSecundarioBrush}" StrokeThickness="2"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                        </Viewbox>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SuperficieHoverBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SuperficieElevadaBrush}" />
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          Margin="12,9,40,9" VerticalAlignment="Center" HorizontalAlignment="Left" />
                        <Popup x:Name="PART_Popup" Placement="Bottom" VerticalOffset="4" IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                            <Border Background="{StaticResource SuperficieElevadaBrush}" BorderBrush="{StaticResource BordaBrush}"
                                    BorderThickness="1" CornerRadius="{StaticResource RaioControle}" Padding="4"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="280">
                                <ScrollViewer>
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource TextoBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource AccentLightBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== TABELAS (DataGrid) ===================== -->
    <!-- Sem linhas de grade pesadas: só uma linha fina de 1px entre as linhas. Hover em Superfície
         hover e seleção em AccentSoft. Cabeçalho em 12 SemiBold, Texto apagado. -->
    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextoBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="RowBackground" Value="Transparent" />
        <Setter Property="AlternatingRowBackground" Value="Transparent" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource BordaBrush}" />
        <Setter Property="VerticalGridLinesBrush" Value="Transparent" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="RowHeaderWidth" Value="0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="CanUserResizeRows" Value="False" />
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextoApagadoBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridColumnHeader">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{StaticResource BordaBrush}"
                            BorderThickness="0,0,0,1">
                        <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="DataGridRow">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextoBrush}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource SuperficieHoverBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="DataGridCell">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="12,9" />
        <Setter Property="Foreground" Value="{StaticResource TextoBrush}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Estilos das células editáveis: as colunas do DataGrid trazem estilos próprios para o
         controle de edição (que ignoram os estilos implícitos), então cada coluna editável aponta
         para estes via ElementStyle / EditingElementStyle. -->
    <Style x:Key="TextoCelulaEdicaoStyle" TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource SuperficieElevadaBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextoBrush}" />
        <Setter Property="CaretBrush" Value="{StaticResource TextoBrush}" />
        <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}" />
        <Setter Property="SelectionOpacity" Value="0.5" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}" CornerRadius="4">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="2,0" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CheckBoxCelulaStyle" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Focusable" Value="False" />
    </Style>

    <Style x:Key="CheckBoxCelulaEdicaoStyle" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="ComboBoxCelulaEdicaoStyle" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- ===================== MENU LATERAL (TabControl principal) ===================== -->
    <!--
        Largura ~248, fundo Barra lateral e linha de 1px na cor Borda separando do conteúdo.
        No topo, o cabeçalho do app (quadrado 42x42 com gradiente + "CubeBin" / "NokyLabs"); no
        rodapé, o botão de recolher e o card com a versão. As partes nomeadas (ColunaSidebar,
        PainelNomeApp, BotaoRecolherSidebar, TxtRecolherMenu, CardVersao, TxtVersaoSidebar) são
        alcançadas pelo código da MainWindow via Template.FindName.
    -->
    <Style TargetType="TabControl">
        <Setter Property="Background" Value="{StaticResource FundoBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="ColunaSidebar" Width="248" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="{StaticResource BarraLateralBrush}"
                                BorderBrush="{StaticResource BordaBrush}" BorderThickness="0,0,1,0">
                            <DockPanel Margin="12,18,12,12">

                                <!-- Cabeçalho do app -->
                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="1,0,0,22">
                                    <Border Width="42" Height="42" CornerRadius="13" Background="{StaticResource CabecalhoAppBrush}">
                                        <Viewbox Width="24" Height="24">
                                            <Path Width="24" Height="24" Data="{StaticResource IconeCubo}"
                                                  Stroke="{StaticResource TextoSobreAccentBrush}" StrokeThickness="2.4"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                        </Viewbox>
                                    </Border>
                                    <StackPanel x:Name="PainelNomeApp" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="CubeBin" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextoBrush}" />
                                        <TextBlock Text="NokyLabs" FontSize="12" Foreground="{StaticResource TextoApagadoBrush}" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- Rodapé: versão + recolher menu -->
                                <Border x:Name="CardVersao" DockPanel.Dock="Bottom" Background="{StaticResource SuperficieBrush}"
                                        BorderBrush="{StaticResource BordaBrush}" BorderThickness="1" CornerRadius="{StaticResource RaioControle}"
                                        Padding="12,8" Margin="0,8,0,0">
                                    <TextBlock x:Name="TxtVersaoSidebar" Text="CubeBin" FontSize="12" Foreground="{StaticResource TextoApagadoBrush}" />
                                </Border>
                                <Button x:Name="BotaoRecolherSidebar" DockPanel.Dock="Bottom" Style="{StaticResource BotaoMenuStyle}"
                                        Tag="{StaticResource IconePainelFechar}" ToolTip="Recolher menu" HorizontalAlignment="Stretch">
                                    <TextBlock x:Name="TxtRecolherMenu" Text="Recolher menu" Margin="12,0,0,0" />
                                </Button>

                                <!-- Itens (as abas). Rolam se a janela ficar baixa demais. -->
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                                    <StackPanel IsItemsHost="True" />
                                </ScrollViewer>
                            </DockPanel>
                        </Border>

                        <Border Grid.Column="1" Background="{StaticResource FundoBrush}">
                            <ContentPresenter ContentSource="SelectedContent" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Item do menu lateral: ícone + texto (14, Medium, Texto secundário). Hover = Superfície
         hover; ativo = fundo AccentSoft com texto e ícone AccentLight. -->
    <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="{StaticResource TextoSecundarioBrush}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocoStyle}" />
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="{StaticResource RaioControle}" Padding="12,10">
                        <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsSelected" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SuperficieHoverBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource TextoBrush}" />
                        </MultiTrigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource AccentLightBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== SUB-ABAS (dentro do Organizar) ===================== -->
    <!-- Aplicadas por chave, nunca implícitas, para não afetar o TabControl principal. Mesmo
         idioma visual do menu lateral, em formato de pílulas lado a lado. -->
    <Style x:Key="SubTabControlStyle" TargetType="TabControl">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <DockPanel>
                        <WrapPanel DockPanel.Dock="Top" IsItemsHost="True" Margin="0,0,0,16" />
                        <ContentPresenter ContentSource="SelectedContent" />
                    </DockPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SubTabItemStyle" TargetType="TabItem">
        <Setter Property="Foreground" Value="{StaticResource TextoSecundarioBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocoStyle}" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Bd" Background="Transparent" BorderBrush="{StaticResource BordaBrush}" BorderThickness="1"
                            CornerRadius="{StaticResource RaioControle}" Padding="16,8">
                        <ContentPresenter ContentSource="Header" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsSelected" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SuperficieHoverBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource TextoBrush}" />
                        </MultiTrigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="Transparent" />
                            <Setter Property="Foreground" Value="{StaticResource AccentLightBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== ÁRVORE (Recall, dentro do Histórico) ===================== -->
    <Style TargetType="TreeView">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextoBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="2" />
    </Style>

    <Style TargetType="TreeViewItem">
        <Setter Property="Foreground" Value="{StaticResource TextoBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TreeViewItem">
                    <StackPanel>
                        <Border x:Name="Bd" CornerRadius="8" Padding="6,6" Margin="0,1">
                            <DockPanel LastChildFill="True">
                                <ToggleButton x:Name="Expansor" DockPanel.Dock="Left" Width="18" Height="18" Margin="0,0,4,0"
                                              ClickMode="Press" Focusable="False"
                                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="Transparent">
                                                <Viewbox Width="14" Height="14" RenderTransformOrigin="0.5,0.5">
                                                    <Viewbox.RenderTransform>
                                                        <RotateTransform x:Name="Giro" Angle="0" />
                                                    </Viewbox.RenderTransform>
                                                    <Path Width="24" Height="24" Data="{StaticResource IconeChevronDireita}"
                                                          Stroke="{StaticResource TextoApagadoBrush}" StrokeThickness="2.5"
                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                                </Viewbox>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Giro" Property="Angle" Value="90" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>
                        <ItemsPresenter x:Name="Filhos" Margin="16,0,0,0" Visibility="Collapsed" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="Filhos" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="HasItems" Value="False">
                            <Setter TargetName="Expansor" Property="Visibility" Value="Hidden" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" SourceName="Bd" Value="True" />
                                <Condition Property="IsSelected" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SuperficieHoverBrush}" />
                        </MultiTrigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource AccentLightBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== MENUS DE CONTEXTO (criados via código) ===================== -->
    <Style TargetType="ContextMenu">
        <Setter Property="Background" Value="{StaticResource SuperficieElevadaBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BordaBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource TextoBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource FonteApp}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource RaioControle}"
                            Padding="4" MinWidth="200">
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextoBrush}" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                        <ContentPresenter ContentSource="Header" Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource TextoApagadoBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== DICAS (ToolTip) ===================== -->
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{StaticResource SuperficieElevadaBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextoBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BordaBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="{StaticResource FonteApp}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="10,6" MaxWidth="360">
                        <ContentPresenter>
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== BARRA DE PROGRESSO ===================== -->
    <!-- Altura 6, canto 3, trilho Superfície elevada, preenchimento Accent. No modo indeterminado,
         um trecho desliza pelo trilho (animação pensada para a barra de 160px do rodapé). -->
    <Style TargetType="ProgressBar">
        <Setter Property="Height" Value="6" />
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        <Setter Property="Background" Value="{StaticResource SuperficieElevadaBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="3" ClipToBounds="True">
                        <Grid ClipToBounds="True">
                            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="3"
                                    HorizontalAlignment="Left" />
                            <Border x:Name="Pulso" Background="{TemplateBinding Foreground}" CornerRadius="3" Width="56"
                                    HorizontalAlignment="Left" Visibility="Collapsed">
                                <Border.RenderTransform>
                                    <TranslateTransform X="-56" />
                                </Border.RenderTransform>
                            </Border>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsIndeterminate" Value="True">
                            <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Pulso" Property="Visibility" Value="Visible" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="AnimacaoPulso">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="Pulso"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                         From="-56" To="160" Duration="0:0:1.4" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="AnimacaoPulso" />
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== SEPARADORES E DIVISORES ===================== -->
    <Style TargetType="Separator">
        <Setter Property="Background" Value="{StaticResource BordaBrush}" />
        <Setter Property="Height" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Background="{TemplateBinding Background}" Height="1" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Divisor arrastável: área de pegar transparente com uma linha fina no meio. -->
    <Style TargetType="GridSplitter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GridSplitter">
                    <Border Background="{TemplateBinding Background}">
                        <Border x:Name="Linha" Background="{StaticResource BordaBrush}" Width="1" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="ResizeDirection" Value="Rows">
                            <Setter TargetName="Linha" Property="Width" Value="Auto" />
                            <Setter TargetName="Linha" Property="Height" Value="1" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Linha" Property="Background" Value="{StaticResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== ROLAGEM ===================== -->
    <!-- Barra fina (8px), polegar Superfície elevada, sem setas, trilho transparente. -->
    <Style x:Key="PolegarRolagemStyle" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Polegar" Background="{StaticResource SuperficieElevadaBrush}" CornerRadius="4" Margin="1" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Polegar" Property="Background" Value="{StaticResource BordaForteBrush}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Polegar" Property="Background" Value="{StaticResource TextoApagadoBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="8" />
        <Setter Property="MinWidth" Value="8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Border Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb Style="{StaticResource PolegarRolagemStyle}" />
                            </Track.Thumb>
                        </Track>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="8" />
                <Setter Property="MinHeight" Value="8" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Border Background="{TemplateBinding Background}">
                                <Track x:Name="PART_Track" Orientation="Horizontal" IsDirectionReversed="False">
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource PolegarRolagemStyle}" />
                                    </Track.Thumb>
                                </Track>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
