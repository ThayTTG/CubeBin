<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CubeBin.App.JanelaContagem"
        Title="CubeBin" Width="400" SizeToContent="Height"
        Icon="/app.ico" CanResize="False" ShowInTaskbar="True" Topmost="True"
        WindowStartupLocation="CenterScreen">
  <!--
    Aviso de início da organização automática no Linux (no Windows esse papel é do toast com
    "Cancelar"). Conta os segundos e some sozinho; "Cancelar" impede a organização desta vez.
  -->
  <Grid Margin="24,24,24,20" RowDefinitions="Auto,Auto">
    <DockPanel>
      <Border DockPanel.Dock="Left" Width="44" Height="44" CornerRadius="22"
              Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Top" Margin="0,0,16,0">
        <Viewbox Width="22" Height="22">
          <Path Classes="icon" Stroke="{DynamicResource AccentTextBrush}" Data="{StaticResource IconeCubo}" />
        </Viewbox>
      </Border>
      <StackPanel>
        <TextBlock Text="A organização vai começar" Classes="h3" TextWrapping="Wrap" />
        <TextBlock x:Name="TxtContagem" FontSize="14" TextWrapping="Wrap" Margin="0,8,0,0"
                   Foreground="{DynamicResource TextSecondaryBrush}" />
        <ProgressBar x:Name="BarraContagem" Minimum="0" Margin="0,14,0,0" />
      </StackPanel>
    </DockPanel>

    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,24,0,0">
      <Button x:Name="BtnCancelar" Content="Cancelar" Classes="secondary ic" Tag="{StaticResource IconeX}"
              MinWidth="96" Click="BtnCancelar_Click" />
      <Button x:Name="BtnComecarAgora" Content="Organizar agora" Classes="primary ic" Tag="{StaticResource IconePlay}"
              MinWidth="96" Click="BtnComecarAgora_Click" />
    </StackPanel>
  </Grid>
</Window>
