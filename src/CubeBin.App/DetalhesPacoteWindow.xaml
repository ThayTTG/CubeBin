<Window x:Class="CubeBin.App.DetalhesPacoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Detalhes do pacote" Height="480" Width="580"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top" x:Name="TxtTituloPacote" FontWeight="Bold" FontSize="14" Margin="0,0,0,4" />
        <TextBlock DockPanel.Dock="Top" x:Name="TxtDataPacote" Opacity="0.8" Margin="0,0,0,4" />
        <TextBlock DockPanel.Dock="Top" x:Name="TxtCaminhoDrivePacote" Opacity="0.7" FontSize="11" Margin="0,0,0,12" />

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="BtnAbrirNoDrive" Content="Abrir no Google Drive" Padding="8,4" Margin="0,0,8,0" Click="BtnAbrirNoDrive_Click" />
            <Button x:Name="BtnRestaurarPacote" Content="Restaurar (baixar de volta)" Style="{StaticResource PrimaryButtonStyle}" Padding="8,4" Click="BtnRestaurarPacote_Click" />
        </StackPanel>

        <DataGrid x:Name="GridItensPacote" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Arquivo" Binding="{Binding NomeArquivo}" Width="180" />
                <DataGridTextColumn Header="Categoria" Binding="{Binding Categoria}" Width="100" />
                <DataGridTextColumn Header="Tamanho" Binding="{Binding TamanhoTexto}" Width="90" />
                <DataGridTextColumn Header="Local original" Binding="{Binding CaminhoOriginal}" Width="220" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
