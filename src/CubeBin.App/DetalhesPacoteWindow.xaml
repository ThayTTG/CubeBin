<Window x:Class="CubeBin.App.DetalhesPacoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Detalhes do pacote" Height="560" Width="700" MinHeight="420" MinWidth="560"
        Style="{StaticResource JanelaStyle}"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="24">
        <!-- Cabeçalho: cubo do pacote + nome, data e onde está no Drive -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,20">
            <Border DockPanel.Dock="Left" Width="56" Height="56" CornerRadius="{StaticResource RaioCard}"
                    Background="{StaticResource SuperficieBrush}" BorderBrush="{StaticResource BordaBrush}" BorderThickness="1"
                    Margin="0,0,16,0" VerticalAlignment="Top">
                <Viewbox Width="36" Height="36">
                    <Canvas Width="64" Height="64">
                        <Path Fill="{StaticResource CuboTopoBrush}" Stroke="{StaticResource CuboTracoBrush}" StrokeThickness="2"
                              StrokeLineJoin="Round" Data="{StaticResource CuboFaceTopo}" />
                        <Path Fill="{StaticResource CuboEsquerdaBrush}" Stroke="{StaticResource CuboTracoBrush}" StrokeThickness="2"
                              StrokeLineJoin="Round" Data="{StaticResource CuboFaceEsquerda}" />
                        <Path Fill="{StaticResource CuboDireitaBrush}" Stroke="{StaticResource CuboTracoBrush}" StrokeThickness="2"
                              StrokeLineJoin="Round" Data="{StaticResource CuboFaceDireita}" />
                    </Canvas>
                </Viewbox>
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="TxtTituloPacote" Style="{StaticResource TituloSecaoStyle}" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="TxtDataPacote" Style="{StaticResource TextoSecundarioStyle}" Margin="0,4,0,0" />
                <TextBlock x:Name="TxtCaminhoDrivePacote" Style="{StaticResource TextoPequenoStyle}" Margin="0,2,0,0" />
            </StackPanel>
        </DockPanel>

        <!-- Ações à direita, a principal por último -->
        <WrapPanel DockPanel.Dock="Bottom" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="BtnAbrirNoDrive" Content="Abrir no Google Drive" Tag="{StaticResource IconeLinkExterno}"
                    Margin="8,0,0,0" Click="BtnAbrirNoDrive_Click" />
            <Button x:Name="BtnRestaurarPacote" Content="Restaurar (baixar de volta)" Style="{StaticResource PrimaryButtonStyle}"
                    Tag="{StaticResource IconeBaixar}" Margin="8,0,0,0" Click="BtnRestaurarPacote_Click" />
        </WrapPanel>

        <Border Style="{StaticResource CardListaStyle}">
            <DataGrid x:Name="GridItensPacote" AutoGenerateColumns="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Arquivo" Binding="{Binding NomeArquivo}" Width="190" />
                    <DataGridTextColumn Header="Categoria" Binding="{Binding Categoria}" Width="110" />
                    <DataGridTextColumn Header="Tamanho" Binding="{Binding TamanhoTexto}" Width="100" />
                    <DataGridTextColumn Header="Local original" Binding="{Binding CaminhoOriginal}" Width="260" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </DockPanel>
</Window>
