<Window x:Class="CubeBin.App.SubpastasWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Subpastas por extensão" Height="460" Width="560" MinHeight="360" MinWidth="440"
        Style="{StaticResource JanelaStyle}"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="24">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <TextBlock Text="Subpastas por extensão" Style="{StaticResource TituloSecaoStyle}" />
            <TextBlock Style="{StaticResource TextoSecundarioStyle}" Margin="0,6,0,0"
                       Text="Defina uma subpasta opcional para cada extensão desta regra. Deixe em branco para o arquivo ir direto para a pasta de destino." />
            <TextBlock Style="{StaticResource TextoPequenoStyle}" Margin="0,6,0,0"
                       Text="Exemplo: extensão .rar com subpasta “WinRAR” vai para Compactados\WinRAR." />
        </StackPanel>

        <!-- Ações à direita, a principal por último -->
        <WrapPanel DockPanel.Dock="Bottom" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="BtnCancelar" Content="Cancelar" Margin="8,0,0,0" Click="BtnCancelar_Click" />
            <Button x:Name="BtnOk" Content="Salvar subpastas" Style="{StaticResource PrimaryButtonStyle}"
                    Tag="{StaticResource IconeVisto}" IsDefault="True" Margin="8,0,0,0" Click="BtnOk_Click" />
        </WrapPanel>

        <Border Style="{StaticResource CardListaStyle}">
            <DataGrid x:Name="GridExtensoes" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Extensão" Binding="{Binding Extensao}" Width="130" IsReadOnly="True" />
                    <DataGridTextColumn Header="Subpasta (opcional)" Binding="{Binding Subpasta}" Width="*"
                                        EditingElementStyle="{StaticResource TextoCelulaEdicaoStyle}" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </DockPanel>
</Window>
