<Window x:Class="CubeBin.App.SubpastasWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Subpastas por extensão" Height="380" Width="480"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,10">
            <Run Text="Defina uma subpasta opcional para cada extensão desta regra." FontWeight="SemiBold" />
            <LineBreak />
            <Run Text="Deixe em branco para o arquivo ir direto para a pasta de destino. Exemplo: extensão .rar com subpasta &quot;WinRAR&quot; vai para Compactados\WinRAR." />
        </TextBlock>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="BtnCancelar" Content="Cancelar" Padding="8,4" Margin="0,0,8,0" Click="BtnCancelar_Click" />
            <Button x:Name="BtnOk" Content="OK" Style="{StaticResource PrimaryButtonStyle}" Padding="8,4" IsDefault="True" Click="BtnOk_Click" />
        </StackPanel>

        <DataGrid x:Name="GridExtensoes" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Extensão" Binding="{Binding Extensao}" Width="120" IsReadOnly="True" />
                <DataGridTextColumn Header="Subpasta (opcional)" Binding="{Binding Subpasta}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
