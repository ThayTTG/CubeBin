<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:NokyLabs.UI"
             x:Class="CubeBin.App.Telas.TelaOrganizar">
  <!--
    O clique em "Organizar agora" (PRD 5.1): Prévia → Confirmação → Execução → Conclusão.
    A prévia aparece sempre no clique manual. O Desfazer usa o registro JSON da execução.
    Layout em colunas, mais quadrado que horizontal.
  -->
  <DockPanel Margin="32,28,32,24">
    <!-- Título e etapas -->
    <StackPanel DockPanel.Dock="Top" Spacing="14" Margin="0,0,0,18">
      <StackPanel>
        <TextBlock Text="Organizar Arquivos" Classes="titulo" />
        <TextBlock x:Name="TxtDescricao" Classes="descricao"
                   Text="Confira o que vai mudar de lugar antes de organizar. Dá para desfazer tudo depois." />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Border x:Name="Etapa1" Classes="etapa ativa"><TextBlock Text="1 · Prévia" /></Border>
        <Border x:Name="Etapa2" Classes="etapa"><TextBlock Text="2 · Confirmação" /></Border>
        <Border x:Name="Etapa3" Classes="etapa"><TextBlock Text="3 · Execução" /></Border>
        <Border x:Name="Etapa4" Classes="etapa"><TextBlock Text="4 · Conclusão" /></Border>
      </StackPanel>
    </StackPanel>

    <!-- Ações (à direita, a principal por último) -->
    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,*,Auto" Margin="0,18,0,0">
      <Button x:Name="BtnDesfazer" Classes="secondary ic" Content="Desfazer" Tag="{StaticResource IconeDesfazer}"
              IsVisible="False" Click="BtnDesfazer_Click" />
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
        <Button x:Name="BtnRelatorio" Classes="secondary ic" Content="Abrir relatório" Tag="{StaticResource IconeDocumento}"
                IsVisible="False" Click="BtnRelatorio_Click" />
        <Button x:Name="BtnVoltar" Classes="secondary ic" Content="Cancelar" Tag="{StaticResource IconeSetaEsquerda}"
                Click="BtnVoltar_Click" />
        <Button x:Name="BtnAvancar" Classes="primary ic" Content="Continuar" Tag="{StaticResource IconeSetaDireita}"
                Click="BtnAvancar_Click" />
      </StackPanel>
    </Grid>

    <Panel>
      <!-- ────────── 1. PRÉVIA ────────── -->
      <Grid x:Name="PainelPrevia" ColumnDefinitions="3*,18,2*">
        <Border Classes="card" Padding="0">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top" Margin="20,18,20,10" Spacing="2">
              <TextBlock Text="VAI MUDAR DE LUGAR" Classes="caps" />
              <TextBlock x:Name="TxtResumoPrevia" Classes="h3" Text="Procurando arquivos…" />
            </StackPanel>
            <ScrollViewer>
              <StackPanel x:Name="ListaDestinos" Margin="20,0,20,18" Spacing="10" />
            </ScrollViewer>
          </DockPanel>
        </Border>
        <Border Grid.Column="2" Classes="card" Padding="0">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top" Margin="20,18,20,10" Spacing="2">
              <TextBlock Text="FICA ONDE ESTÁ" Classes="caps" />
              <TextBlock Classes="secondary" FontSize="13"
                         Text="Protegidos, sem pasta definida ou que precisam de você." />
            </StackPanel>
            <ScrollViewer>
              <StackPanel x:Name="ListaFica" Margin="20,0,20,18" Spacing="10" />
            </ScrollViewer>
          </DockPanel>
        </Border>
        <!-- Carregando / vazio -->
        <Border x:Name="PainelCarregando" Grid.ColumnSpan="3" Background="{DynamicResource BgBrush}" IsVisible="False">
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12" Width="320">
            <TextBlock x:Name="TxtCarregando" Text="Olhando suas pastas…" Classes="h3" HorizontalAlignment="Center" />
            <ProgressBar IsIndeterminate="True" Classes="slim" />
          </StackPanel>
        </Border>
      </Grid>

      <!-- ────────── 2. CONFIRMAÇÃO ────────── -->
      <Grid x:Name="PainelConfirmacao" IsVisible="False" ColumnDefinitions="*,18,*">
        <Border Classes="card">
          <StackPanel Spacing="16">
            <Border Classes="iconeBloco" Width="52" Height="52" HorizontalAlignment="Left">
              <Viewbox Width="26" Height="26"><Path Classes="icon" Data="{StaticResource IconeOrganizar}" /></Viewbox>
            </Border>
            <TextBlock x:Name="TxtConfirmaTitulo" Classes="h2" TextWrapping="Wrap" />
            <TextBlock x:Name="TxtConfirmaDetalhe" Classes="secondary" TextWrapping="Wrap" />
            <StackPanel x:Name="ListaConfirmaDestinos" Spacing="6" />
          </StackPanel>
        </Border>
        <Border Grid.Column="2" Classes="card">
          <StackPanel Spacing="14">
            <TextBlock Text="SEU CAMINHO DE VOLTA" Classes="caps" />
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Viewbox Width="18" Height="18"><Path Classes="icon accent" Data="{StaticResource IconeEscudo}" /></Viewbox>
              <TextBlock TextWrapping="Wrap" MaxWidth="320"
                         Text="Antes de mexer em cada arquivo, o CubeBin anota de onde ele saiu. O botão Desfazer devolve tudo ao lugar." />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Viewbox Width="18" Height="18"><Path Classes="icon accent" Data="{StaticResource IconeDocumento}" /></Viewbox>
              <TextBlock TextWrapping="Wrap" MaxWidth="320"
                         Text="Arquivos com o mesmo nome no destino ganham o nome da pasta de origem na frente (ex.: Doc-Texto). Nada é sobrescrito." />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Viewbox Width="18" Height="18"><Path Classes="icon accent" Data="{StaticResource IconeAtualizar}" /></Viewbox>
              <TextBlock TextWrapping="Wrap" MaxWidth="320"
                         Text="No fim, um relatório mostra cada arquivo, de onde saiu e para onde foi." />
            </StackPanel>
            <StackPanel x:Name="PainelOneDrive" Spacing="8" IsVisible="False">
              <Border x:Name="AvisoOneDrive" />
              <CheckBox x:Name="ChkOneDrive" Content="Entendi, pode mover mesmo assim" IsCheckedChanged="ChkOneDrive_Changed" />
            </StackPanel>
          </StackPanel>
        </Border>
      </Grid>

      <!-- ────────── 3. EXECUÇÃO ────────── -->
      <Border x:Name="PainelExecucao" IsVisible="False" Classes="card" MaxWidth="560"
              VerticalAlignment="Center" HorizontalAlignment="Stretch">
        <StackPanel Spacing="14">
          <TextBlock Text="Organizando…" Classes="h2" />
          <TextBlock x:Name="TxtExecucaoContagem" Classes="secondary" Text="0 de 0" />
          <ProgressBar x:Name="BarraExecucao" Classes="slim" Minimum="0" Maximum="1" />
          <TextBlock x:Name="TxtExecucaoArquivo" Classes="muted" TextTrimming="CharacterEllipsis" />
          <TextBlock Classes="pequeno"
                     Text="Pode parar a qualquer momento: o que já foi movido fica anotado e pode ser desfeito." />
        </StackPanel>
      </Border>

      <!-- ────────── 4. CONCLUSÃO ────────── -->
      <Grid x:Name="PainelConclusao" IsVisible="False" ColumnDefinitions="*,18,*">
        <Border Classes="card">
          <StackPanel Spacing="14">
            <Border x:Name="FundoIconeConclusao" Classes="iconeBloco" Width="52" Height="52" HorizontalAlignment="Left">
              <Viewbox Width="26" Height="26"><Path x:Name="IconeConclusao" Classes="icon" Data="{StaticResource IconeSucesso}" /></Viewbox>
            </Border>
            <TextBlock x:Name="TxtConclusaoTitulo" Classes="h2" TextWrapping="Wrap" />
            <TextBlock x:Name="TxtConclusaoDetalhe" Classes="secondary" TextWrapping="Wrap" />
            <StackPanel x:Name="ListaConclusaoDestinos" Spacing="6" />
          </StackPanel>
        </Border>
        <Border Grid.Column="2" Classes="card" Padding="0">
          <ScrollViewer>
            <StackPanel x:Name="ListaConclusaoAvisos" Margin="20" Spacing="10" />
          </ScrollViewer>
        </Border>
      </Grid>
    </Panel>
  </DockPanel>
</UserControl>
