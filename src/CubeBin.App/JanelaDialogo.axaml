<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CubeBin.App.JanelaDialogo"
        Title="CubeBin" Width="460" SizeToContent="Height" MaxHeight="640"
        Icon="/app.ico" CanResize="False" ShowInTaskbar="False">
  <!--
    Diálogo de mensagem/confirmação no visual da NokyLabs, no lugar da MessageBox do Windows.
    Chamado sempre por DialogoCubeBin.Show(...), que tem a mesma forma de chamar da MessageBox;
    o texto, os botões, o ícone e o botão padrão são definidos no código.
  -->
  <Grid Margin="24,24,24,20" RowDefinitions="*,Auto">
    <DockPanel>
      <Border x:Name="FundoIcone" DockPanel.Dock="Left" Width="44" Height="44" CornerRadius="22"
              Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Top" Margin="0,0,16,0">
        <Viewbox Width="22" Height="22">
          <Path x:Name="IconeDialogo" Classes="icon" Stroke="{DynamicResource AccentTextBrush}"
                Data="{StaticResource IconeInfo}" />
        </Viewbox>
      </Border>
      <StackPanel>
        <TextBlock x:Name="TxtTitulo" Classes="h3" TextWrapping="Wrap" />
        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="420" Margin="0,8,0,0">
          <SelectableTextBlock x:Name="TxtMensagem" FontSize="14" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
        </ScrollViewer>
      </StackPanel>
    </DockPanel>

    <!-- Ações à direita, a principal por último -->
    <StackPanel x:Name="PainelBotoes" Grid.Row="1" Orientation="Horizontal" Spacing="8"
                HorizontalAlignment="Right" Margin="0,24,0,0" />
  </Grid>
</Window>
