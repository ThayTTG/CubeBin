<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:NokyLabs.UI"
             x:Class="CubeBin.App.App"
             RequestedThemeVariant="Dark">

  <!--
    O app continua residente na bandeja mesmo com a janela fechada: só encerra pelo "Sair" do
    menu do ícone (ShutdownMode="OnExplicitShutdown", ligado em App.axaml.cs).
    Cores, botões e animações vêm do Kit NokyLabs (lib/NokyLabs.UI), no vermelho do CubeBin.
  -->

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- Ícones, ilustrações e cores neutras do CubeBin. -->
        <ResourceInclude Source="avares://CubeBin/Interface/Recursos.axaml" />
      </ResourceDictionary.MergedDictionaries>

      <!-- Expander (listas que abrem na prévia) sem o fundo escuro do Fluent: herda o cartão. -->
      <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="Transparent" />
      <SolidColorBrush x:Key="ExpanderHeaderBackgroundPointerOver" Color="Transparent" />
      <SolidColorBrush x:Key="ExpanderHeaderBackgroundPressed" Color="Transparent" />
      <SolidColorBrush x:Key="ExpanderHeaderBackgroundDisabled" Color="Transparent" />
      <SolidColorBrush x:Key="ExpanderHeaderBorderBrush" Color="Transparent" />
      <SolidColorBrush x:Key="ExpanderHeaderBorderBrushPointerOver" Color="Transparent" />
      <SolidColorBrush x:Key="ExpanderHeaderBorderBrushPressed" Color="Transparent" />
      <SolidColorBrush x:Key="ExpanderContentBackground" Color="Transparent" />
      <SolidColorBrush x:Key="ExpanderContentBorderBrush" Color="Transparent" />
      <SolidColorBrush x:Key="ExpanderChevronBackground" Color="Transparent" />
      <SolidColorBrush x:Key="ExpanderChevronBackgroundPointerOver" Color="#231B3E" />
      <SolidColorBrush x:Key="ExpanderChevronBackgroundPressed" Color="#2A2149" />
      <SolidColorBrush x:Key="ExpanderChevronBorderBrush" Color="Transparent" />
      <SolidColorBrush x:Key="ExpanderChevronBorderBrushPointerOver" Color="Transparent" />
      <SolidColorBrush x:Key="ExpanderChevronBorderBrushPressed" Color="Transparent" />
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
    <ui:NokyTheme Accent="#C4362E" />
    <!-- Textos das páginas, cartões, botões com ícone, blocos e tabelas. -->
    <StyleInclude Source="avares://CubeBin/Interface/Estilos.axaml" />
  </Application.Styles>

</Application>
