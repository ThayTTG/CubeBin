<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:NokyLabs.UI"
             x:Class="CubeBin.App.App"
             RequestedThemeVariant="Dark">

  <!--
    O app continua residente na bandeja mesmo com a janela fechada: só encerra pelo "Sair" do
    menu do ícone (ShutdownMode="OnExplicitShutdown", ligado em App.axaml.cs).
    Cores, botões e animações vêm do Kit NokyLabs (lib/NokyLabs.UI), no vermelho do CubeBin.
  -->

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- Ícones, ilustrações e cores neutras divididos com o outro app da família. -->
        <ResourceInclude Source="avares://Comum.UI/Recursos.axaml" />
      </ResourceDictionary.MergedDictionaries>

      <!-- O cubo dos pacotes: as três faces em tons do vermelho do CubeBin. -->
      <SolidColorBrush x:Key="CuboTracoBrush" Color="#F4A7A1" />
      <SolidColorBrush x:Key="CuboTopoBrush" Color="#B3D64A40" />
      <SolidColorBrush x:Key="CuboEsquerdaBrush" Color="#99C4362E" />
      <SolidColorBrush x:Key="CuboDireitaBrush" Color="#8CA32D26" />
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
    <ui:NokyTheme Accent="#C4362E" />
    <!-- Textos das páginas, cartões, botões com ícone e tabelas, iguais nos dois apps. -->
    <StyleInclude Source="avares://Comum.UI/Estilos.axaml" />
  </Application.Styles>

</Application>
