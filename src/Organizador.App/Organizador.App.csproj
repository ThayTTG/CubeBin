<Project Sdk="Microsoft.NET.Sdk">

  <!--
    O organizador de arquivos da NokyLabs: a parte "Organizar" do CubeBin 2.x, agora um app
    próprio. Interface em Avalonia + NokyLabs.UI. O nome ainda é provisório ("Organizador"): o
    nome mostrado vem de InfoApp.Nome, e o nome do executável é o AssemblyName abaixo.
  -->
  <!--
    Windows: net8.0-windows10.0.19041.0 (toasts nativos, ícone e manifesto do .exe).
    Linux: net8.0 puro. Vale tanto para compilar no Linux quanto para publicar a partir do
    Windows com "-r linux-x64" (o -r decide quando foi informado; senão, o sistema atual).
  -->
  <PropertyGroup>
    <AlvoLinux Condition="'$(RuntimeIdentifier)' != '' and !$(RuntimeIdentifier.StartsWith('win'))">true</AlvoLinux>
    <AlvoLinux Condition="'$(RuntimeIdentifier)' == '' and !$([MSBuild]::IsOSPlatform('Windows'))">true</AlvoLinux>
  </PropertyGroup>

  <PropertyGroup Condition="'$(AlvoLinux)' != 'true'">
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <!-- Permite compilar (e testar a tela) fora do Windows também. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <PropertyGroup Condition="'$(AlvoLinux)' == 'true'">
    <TargetFramework>net8.0</TargetFramework>
  </PropertyGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Organizador.App</RootNamespace>
    <AssemblyName>Organizador</AssemblyName>
    <Version>1.0.0</Version>
    <Product>Organizador</Product>
    <AssemblyTitle>Organizador</AssemblyTitle>
    <Company>NokyLabs</Company>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.*" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.*" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.*" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.*" />
    <!-- As tabelas (regras, pendências, histórico...). -->
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="11.3.*" />
  </ItemGroup>

  <ItemGroup Condition="'$(AlvoLinux)' != 'true'">
    <!-- Toasts nativos do Windows 10/11 (aviso de início com "Cancelar" e resumo final). -->
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
  </ItemGroup>

  <ItemGroup Condition="'$(AlvoLinux)' == 'true'">
    <!-- O toast é só do Windows; no Linux os avisos ficam no LinuxNotificationService. -->
    <Compile Remove="Services\ToastNotificationService.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Organizador.Core\Organizador.Core.csproj" />
    <ProjectReference Include="..\Comum.UI\Comum.UI.csproj" />
    <!-- O Kit NokyLabs (submódulo Git em lib/NokyLabs.UI). -->
    <ProjectReference Include="..\..\lib\NokyLabs.UI\src\NokyLabs.UI\NokyLabs.UI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- O ícone vai dentro do programa (janela e bandeja). Provisório até o app ganhar nome. -->
    <AvaloniaResource Include="app.ico" />
    <!-- No Linux a bandeja usa o PNG (o padrão do StatusNotifierItem). -->
    <AvaloniaResource Include="icon.png" />
  </ItemGroup>

  <ItemGroup Condition="'$(AlvoLinux)' == 'true'">
    <!-- icon.png solto ao lado do executável: o NokyLabs Launcher usa no atalho (.desktop),
         e o próprio app usa no autostart e nas notificações. -->
    <None Include="icon.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"
          ExcludeFromSingleFile="true" />
  </ItemGroup>

</Project>
