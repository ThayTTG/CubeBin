<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Paleta preto/vermelho, cantos retos, menu lateral — definida em um único lugar para não
        espalhar hex pelos arquivos de UI. Ver spec-organizador-arquivos.md, seção de estética,
        para o racional por trás das escolhas (vermelho reservado para acento, não para status).
    -->

    <Color x:Key="PrimaryBlackColor">#0D0D0D</Color>
    <Color x:Key="SidebarActiveColor">#1C1C1C</Color>
    <Color x:Key="SidebarHoverColor">#1A1A1A</Color>
    <Color x:Key="ContentBackgroundColor">#161616</Color>
    <Color x:Key="FieldBackgroundColor">#0D0D0D</Color>
    <Color x:Key="BorderLineColor">#2A2A2A</Color>
    <Color x:Key="BorderStrongColor">#3A3A3A</Color>

    <Color x:Key="AccentColor">#C4362E</Color>
    <Color x:Key="AccentHoverColor">#A32D26</Color>
    <Color x:Key="AccentPressedColor">#872520</Color>

    <Color x:Key="TextPrimaryColor">#EDEDED</Color>
    <Color x:Key="TextSecondaryColor">#8A8A8A</Color>
    <Color x:Key="TextOnAccentColor">#FFFFFF</Color>

    <!-- Avisos genuínos (erro/atenção) ficam num âmbar distinto do vermelho de marca, para o
         vermelho continuar significando só "ação/marca" e não competir com sinalização real. -->
    <Color x:Key="WarningBackgroundColor">#3D3319</Color>
    <Color x:Key="WarningBorderColor">#5A4614</Color>
    <Color x:Key="WarningTextColor">#E8C77A</Color>

    <!-- Cores de estado do Recall (item 3 do feedback de estética) — tons escuros/saturados
         pensados para fundo preto, substituindo os pastéis originais (pensados para fundo claro). -->
    <Color x:Key="RecallAtivoColor">#1B2C3D</Color>
    <Color x:Key="RecallPendenteColor">#3D3319</Color>
    <Color x:Key="RecallRestauradoColor">#1C3325</Color>

    <SolidColorBrush x:Key="PrimaryBlackBrush" Color="{StaticResource PrimaryBlackColor}" />
    <SolidColorBrush x:Key="SidebarActiveBrush" Color="{StaticResource SidebarActiveColor}" />
    <SolidColorBrush x:Key="SidebarHoverBrush" Color="{StaticResource SidebarHoverColor}" />
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="{StaticResource ContentBackgroundColor}" />
    <SolidColorBrush x:Key="FieldBackgroundBrush" Color="{StaticResource FieldBackgroundColor}" />
    <SolidColorBrush x:Key="BorderLineBrush" Color="{StaticResource BorderLineColor}" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}" />

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="{StaticResource TextOnAccentColor}" />

    <SolidColorBrush x:Key="WarningBackgroundBrush" Color="{StaticResource WarningBackgroundColor}" />
    <SolidColorBrush x:Key="WarningBorderBrush" Color="{StaticResource WarningBorderColor}" />
    <SolidColorBrush x:Key="WarningTextBrush" Color="{StaticResource WarningTextColor}" />

    <SolidColorBrush x:Key="RecallAtivoBrush" Color="{StaticResource RecallAtivoColor}" />
    <SolidColorBrush x:Key="RecallPendenteBrush" Color="{StaticResource RecallPendenteColor}" />
    <SolidColorBrush x:Key="RecallRestauradoBrush" Color="{StaticResource RecallRestauradoColor}" />

</ResourceDictionary>
