<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>OrganizadorArquivos.App</RootNamespace>
    <!-- Sem ícone próprio ainda (design simples nesta fase, conforme spec). Adicionar
         <ApplicationIcon>app.ico</ApplicationIcon> aqui quando o ícone definitivo existir. -->
  </PropertyGroup>

  <ItemGroup>
    <!-- Biblioteca para toasts nativos do Windows 10/11 em apps desktop clássicos (WPF/WinForms) -->
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OrganizadorArquivos.Core\OrganizadorArquivos.Core.csproj" />
  </ItemGroup>

</Project>
