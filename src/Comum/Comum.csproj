<Project Sdk="Microsoft.NET.Sdk">

  <!--
    O que os dois apps da família usam igual, sem nada de tela: mover arquivos com segurança,
    registro em CSV antes de mexer, saber se a pessoa está longe do computador, abrir junto com o
    Windows, a conta dos horários e a leitura do config antigo da versão 2.x.
  -->
  <PropertyGroup>
    <!-- net8.0 puro: serve ao Windows e ao Linux. O que é só do Windows fica atrás de
         OperatingSystem.IsWindows(). -->
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Comum</RootNamespace>
  </PropertyGroup>

</Project>
